# Keep the kinematic URDF in Git; the large local CAD/mesh bundle remains local.
/Dummy_URDF/*
!/Dummy_URDF/dummy.urdf

# Local STM32CubeIDE/CMake/VS Code state for the Dummy firmware projects.
/.vscode/
/Firmware/dummy-*/.clangd
/Firmware/dummy-*/.settings/
/Firmware/dummy-*/.vscode/
/Firmware/**/build*/
