/Firmware/dummy-*/build-codex/
/Firmware/dummy-*/cmake-build-*/
/Firmware/dummy-*/mx.scratch/

# Local hardware-validation outputs. Keep the canonical teleop_inputs.yaml,
# but ignore per-run copies produced from DUMMY_RUN_ID.
/Upper/dummy-host/logs/
/Upper/dummy-host/sessions/
/Upper/dummy-host/configs/teleop_inputs_*.yaml
